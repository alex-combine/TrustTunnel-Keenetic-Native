+/*
+ * Set a user-specified ClientRandom (same API as AdGuard's BoringSSL patch).
+ * Copies up to SSL3_RANDOM_SIZE bytes; a shorter value is padded with
+ * cryptographically secure random bytes. Meant for TLS 1.3, where the
+ * ClientRandom does not feed key derivation; with TLS <= 1.2 the value must
+ * itself come from a CSPRNG.
+ */
+void SSL_set_custom_client_random(SSL *ssl, const unsigned char *data, size_t len)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(ssl);
+    unsigned char buf[SSL3_RANDOM_SIZE];
+    size_t n;
+
+    if (sc == NULL || (data == NULL && len != 0))
+        return;
+    /* build the value aside: a failed RNG must not leave a half-new value in use */
+    n = len < sizeof(buf) ? len : sizeof(buf);
+    if (n > 0)
+        memcpy(buf, data, n);
+    if (n < sizeof(buf)
+        && RAND_bytes_ex(SSL_CONNECTION_GET_CTX(sc)->libctx, buf + n, sizeof(buf) - n, 0) <= 0) {
+        OPENSSL_cleanse(buf, sizeof(buf));
+        return;
+    }
+    memcpy(sc->custom_client_random, buf, sizeof(buf));
+    OPENSSL_cleanse(buf, sizeof(buf));
+    sc->custom_client_random_set = 1;
+}
+
 size_t SSL_get_client_random(const SSL *ssl, unsigned char *out, size_t outlen)
 {
     const SSL_CONNECTION *sc = SSL_CONNECTION_FROM_CONST_SSL(ssl);
