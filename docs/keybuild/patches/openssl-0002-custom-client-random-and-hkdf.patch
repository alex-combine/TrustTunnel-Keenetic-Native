diff --git a/include/openssl/hkdf.h b/include/openssl/hkdf.h
new file mode 100644
index 0000000..3114a1a
--- /dev/null
+++ b/include/openssl/hkdf.h
@@ -0,0 +1,56 @@
+/*
+ * BoringSSL-compatible HKDF() on top of OpenSSL's EVP_PKEY HKDF.
+ * Same argument order as BoringSSL's <openssl/hkdf.h>: returns 1 on success.
+ */
+#ifndef OPENSSL_HKDF_COMPAT_H
+#define OPENSSL_HKDF_COMPAT_H
+/* tells callers that HKDF() below has BoringSSL's argument order */
+#define OPENSSL_HKDF_BORINGSSL_COMPAT 1
+
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <openssl/evp.h>
+#include <openssl/kdf.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline int HKDF(uint8_t *out_key, size_t out_len, const EVP_MD *digest,
+    const uint8_t *secret, size_t secret_len,
+    const uint8_t *salt, size_t salt_len,
+    const uint8_t *info, size_t info_len)
+{
+    EVP_PKEY_CTX *pctx;
+    int ok;
+
+    /* the EVP_PKEY HKDF setters take int lengths: refuse instead of truncating */
+    /* note: OpenSSL also caps the total info length (about 1-2 KB, smaller than
+     * BoringSSL); a longer info makes the derive fail and HKDF() return 0.
+     * TrustTunnel passes a short SNI-based info, far below the cap. */
+    if (secret_len > INT_MAX || salt_len > INT_MAX || info_len > INT_MAX)
+        return 0;
+    if (out_len == 0)   /* nothing to derive: success, as in BoringSSL */
+        return digest != NULL;
+    /* EVP_PKEY_derive(ctx, NULL, &len) only reports the size: never report that as a derived key */
+    if (out_key == NULL)
+        return 0;
+    pctx = EVP_PKEY_CTX_new_id(EVP_PKEY_HKDF, NULL);
+    ok = pctx != NULL
+        && EVP_PKEY_derive_init(pctx) > 0
+        && EVP_PKEY_CTX_set_hkdf_md(pctx, digest) > 0
+        && EVP_PKEY_CTX_set1_hkdf_key(pctx, secret, (int)secret_len) > 0
+        && (salt_len == 0 || EVP_PKEY_CTX_set1_hkdf_salt(pctx, salt, (int)salt_len) > 0)
+        && (info_len == 0 || EVP_PKEY_CTX_add1_hkdf_info(pctx, info, (int)info_len) > 0)
+        && EVP_PKEY_derive(pctx, out_key, &out_len) > 0;
+
+    EVP_PKEY_CTX_free(pctx);
+    return ok ? 1 : 0;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* OPENSSL_HKDF_COMPAT_H */
