#!/opt/bin/sh
#
# tt-stats — traffic statistics in the Keenetic web UI for the TrustTunnel TUN
# connection (OpkgTunN), with safe switching and automatic rollback.
#
# Why: KeeneticOS creates its own opkgtunN device for the OpkgTunN interface and
# collects dashboard statistics only for that device. The classic setup lets the
# client create tun0, deletes the firmware device and renames tun0 -> opkgtunN,
# so the dashboard always shows 0. In attach mode the client attaches to the
# firmware device (listener.tun device_name + use_existing, client >= 1.0.62).
#
# Commands:
#   status             show mode, client version, dashboard statistics state
#   enable [--reboot]  switch to attach mode (auto-rollback if the VPN does not come up)
#   disable            return to the classic mode from the backup
#   reboot             run pre-flight checks and reboot the router
#   guard              boot check (called by /opt/etc/init.d/S99ttstats-guard)
#   memguard on [KB]|off|status
#                      memory guard for 128 MB routers: restart the client when free
#                      memory drops below KB (default 15000) instead of letting the router hang;
#                      a small client is left alone, the VPN pauses only if memory stays critical,
#                      and a bloated client is restarted once a night (/opt/etc/cron.daily);
#                      overload brake: low memory and a high load for 2 minutes -> stop heavy optional
#                      jobs and shorten the UDP conntrack timeout for 10 minutes
#   apply FILE|LINK [SEC]
#                      replace the client config safely: restart, check through the tunnel
#                      (a tt://... link replaces only the server part, the rest stays)
#                      for SEC seconds (default 60), roll back by itself if the VPN does not come up
#   apply-status       result of the last apply
#   selftest           read-only check: client, tunnel, exit IP, DNS, kill switch, auth key
#   keybuild [status|install [FILE]|revert]
#                      MIPS (mipsel) routers: swap in the client build with auth key support
#                      (client_random_auth_key) with automatic rollback, or put the replaced client back
#   update-check       is a newer release out? Reads only the version number, downloads and
#                      changes nothing. A daily check is installed in /opt/etc/cron.daily
#
# Log: /opt/var/log/tt-stats.log, memory guard: /opt/var/log/tt-memguard.log

TTS_VERSION="2.4.0"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
TTS_REPO_URL="${TTS_REPO_URL:-https://github.com/alex-combine/TrustTunnel-Keenetic-Native/releases/latest/download}"

PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
[ -z "$TZ" ] && [ -f /etc/TZ ] && TZ="$(cat /etc/TZ)" && export TZ

TT_DIR="/opt/trusttunnel_client"
CLIENT_BIN="$TT_DIR/trusttunnel_client"
CONFIG_FILE="$TT_DIR/trusttunnel_client.toml"
MODE_CONF="$TT_DIR/mode.conf"
INIT_SCRIPT="/opt/etc/init.d/S99trusttunnel"
WAN_HOOK="/opt/etc/ndm/wan.d/010-trusttunnel.sh"
GUARD_SCRIPT="/opt/etc/init.d/S99ttstats-guard"
CLIENT_LOG="/opt/var/log/trusttunnel.log"
BACKUP_DIR="$TT_DIR/backup-classic"
LOG="/opt/var/log/tt-stats.log"
DONE_FLAG="/tmp/tt-stats.done"
MIN_CLIENT_VERSION="1.0.62"
TTS_GH_REPO="alex-combine/TrustTunnel-Keenetic-Native"
TTS_LATEST_URL="${TTS_LATEST_URL:-https://github.com/$TTS_GH_REPO/releases/latest}"
TTS_MIN_URL="${TTS_MIN_URL:-https://raw.githubusercontent.com/$TTS_GH_REPO/main/MIN_VERSION}"
UPD_CACHE="/tmp/tt-stats.update"                      # last check result (RAM, refreshed daily)
UPD_NOTIFIED="/opt/var/run/tt-stats.notified"         # last version written to the router log
UPD_CRON="${TTS_UPD_CRON:-/opt/etc/cron.daily/tt-stats-update-check}"
MEMGUARD_INIT="${MEMGUARD_INIT:-/opt/etc/init.d/S97tt-memguard}"
MEMGUARD_PID="${MEMGUARD_PID:-/opt/var/run/tt-memguard.pid}"
MEMGUARD_LOG="${MEMGUARD_LOG:-/opt/var/log/tt-memguard.log}"
MEMGUARD_BOX="${MEMGUARD_BOX:-/opt/var/log/tt-blackbox.log}"   # who used memory and connections
MEMGUARD_PAUSE="/tmp/tt-memguard.pause"
MEMGUARD_HIST="/tmp/tt-memguard.hist"
MEMGUARD_CRON="${MEMGUARD_CRON:-/opt/etc/cron.daily/tt-memguard-nightly}"
MEMGUARD_UDPT="/tmp/tt-memguard.udp-timeout"   # saved UDP conntrack timeout while the brake is on
UDP_TIMEOUT_FILE="${UDP_TIMEOUT_FILE:-/proc/sys/net/netfilter/nf_conntrack_udp_timeout}"
MG_TARGET="${MG_TARGET:-/opt/etc/init.d/S99trusttunnel}"   # what the guard restarts (overridable for tests)

TT_MODE="socks5"
TUN_IDX="0"
TUN_USE_EXISTING="no"
HC_TARGET_URL="http://connectivitycheck.gstatic.com/generate_204"
# shellcheck source=/dev/null
[ -f "$MODE_CONF" ] && . "$MODE_CONF"
TUN_IDX="${TUN_IDX:-0}"
# Memory guard defaults follow the router's memory: tight ones are needed only on 128 MB.
# A value set in mode.conf (or by "tt-stats memguard on KB") always wins.
MEM_TOTAL_KB=$(awk '/^MemTotal:/ {print $2; exit}' "${MEMINFO_FILE:-/proc/meminfo}" 2>/dev/null)
if [ "${MEM_TOTAL_KB:-0}" -ge 400000 ] 2>/dev/null; then MG_TIER=512; d_low=40000; d_bloat=60000; d_dns=300; d_swp=0; d_night=0
elif [ "${MEM_TOTAL_KB:-0}" -ge 180000 ] 2>/dev/null; then MG_TIER=256; d_low=25000; d_bloat=40000; d_dns=200; d_swp=10; d_night=20000
else MG_TIER=128; d_low=15000; d_bloat=25000; d_dns=120; d_swp=10; d_night=12000; fi
# a typo in mode.conf falls back to the default; leading zeros are dropped ($(( 08 )) would be read as octal)
numor() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) v=$(echo "$1" | sed 's/^0*//'); echo "${v:-0}" ;; esac; }
MEMGUARD_LOW_KB=$(numor "$MEMGUARD_LOW_KB" $d_low)
MEMGUARD_CRIT_KB=$(numor "$MEMGUARD_CRIT_KB" $((MEMGUARD_LOW_KB * 2 / 3)))   # pause the VPN only below this
MEMGUARD_SMALL_KB="${MEMGUARD_SMALL_KB:-5000}"   # client smaller than this: memory is eaten by something else
MEMGUARD_NIGHT_KB="${MEMGUARD_NIGHT_KB:-$d_night}"  # nightly restart if the client is bigger (0 = off)
MEMGUARD_LOAD="${MEMGUARD_LOAD:-20}"             # overload brake: load average at or above this (0 = off)
MEMGUARD_SHED="${MEMGUARD_SHED:-geo-build.sh}"   # heavy optional jobs to stop under overload
MEMGUARD_BOX_LOAD="${MEMGUARD_BOX_LOAD:-8}"     # black box: a snapshot a minute from this load (0 = off)
MEMGUARD_BLOAT_KB="${MEMGUARD_BLOAT_KB:-$d_bloat}"  # restart a client that grew past this (RAM + swap) without waiting for low memory (0 = off)
MEMGUARD_BLOAT_GAP="${MEMGUARD_BLOAT_GAP:-1800}" # ...but not more often than once per this many seconds
MEMGUARD_SWAPPINESS="${MEMGUARD_SWAPPINESS:-$d_swp}" # how eagerly the kernel pushes memory to swap (it is only ever lowered; 0 = leave as is)
SWAPPINESS_FILE="${SWAPPINESS_FILE:-/proc/sys/vm/swappiness}"
DNSLIM_MAX="${DNSLIM_MAX:-$d_dns}"                  # DNS requests one device may have open at the router (they live ~30 s; normal is 5-40, a storm 200-300; 0 = off)
DNSLIM_HOOK="${DNSLIM_HOOK:-/opt/etc/ndm/netfilter.d/58-tt-dnslimit.sh}"
DNSLIM_IF="${DNSLIM_IF:-br+}"                    # LAN bridges
DNSLIM_EXEMPT="${DNSLIM_EXEMPT:-}"               # addresses without the limit: a second router, Pi-hole/AdGuard on a NAS (space-separated, IPv4/IPv6)
MEMGUARD_BLOAT_KB=$(numor "$MEMGUARD_BLOAT_KB" $d_bloat); MEMGUARD_BLOAT_GAP=$(numor "$MEMGUARD_BLOAT_GAP" 1800)
MEMGUARD_SWAPPINESS=$(numor "$MEMGUARD_SWAPPINESS" $d_swp); MEMGUARD_BOX_LOAD=$(numor "$MEMGUARD_BOX_LOAD" 8)
MEMGUARD_LOAD=$(numor "$MEMGUARD_LOAD" 20); DNSLIM_MAX=$(numor "$DNSLIM_MAX" $d_dns)
MEMGUARD_NIGHT_KB=$(numor "$MEMGUARD_NIGHT_KB" $d_night)
OPKG_IFACE="opkgtun${TUN_IDX}"
NDM_IFACE="OpkgTun${TUN_IDX}"

# The client config is the single source of truth for attach mode
attach_in_config() { grep -q '^[[:space:]]*use_existing[[:space:]]*=[[:space:]]*true' "$CONFIG_FILE" 2>/dev/null; }
if attach_in_config; then TUN_USE_EXISTING="yes"; else TUN_USE_EXISTING="no"; fi

# ---------------------------------------------------------------- helpers ---

ts()  { date '+%Y-%m-%d %H:%M:%S'; }
log() { mkdir -p "$(dirname "$LOG")"; echo "$(ts) $*" >> "$LOG"; logger -t tt-stats "$*" 2>/dev/null; }
say() { echo "$*"; log "$*"; }
die() { echo "Error: $*" >&2; log "ERROR: $*"; exit 1; }

ndm() { ndmc -c "$1" 2>/dev/null | tr -d '\033' | sed 's/\[K//g'; }

client_version() {
    [ -x "$CLIENT_BIN" ] || return 1
    "$CLIENT_BIN" --version 2>/dev/null | awk '{print $2; exit}'
}

# version_ge A B -> true if A >= B (numeric dotted versions)
version_ge() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        na = split(a, x, "."); nb = split(b, y, ".")
        n = (na > nb) ? na : nb
        for (i = 1; i <= n; i++) {
            xi = (i <= na) ? x[i] + 0 : 0; yi = (i <= nb) ? y[i] + 0 : 0
            if (xi > yi) exit 0
            if (xi < yi) exit 1
        }
        exit 0
    }'
}

# VPN works = HTTP check through the tunnel device succeeds (same idea as S99 health check)
vpn_ok() {
    code=$(curl --interface "$OPKG_IFACE" -s -o /dev/null -m 8 -w '%{http_code}' "$HC_TARGET_URL" 2>/dev/null)
    case "$code" in 2??|3??) return 0 ;; *) return 1 ;; esac
}

wait_vpn() {  # $1 = seconds
    _w=0
    while [ "$_w" -lt "$1" ]; do
        vpn_ok && return 0
        sleep 5
        _w=$((_w + 5))
    done
    return 1
}

client_attached() {
    tail -n 400 "$CLIENT_LOG" 2>/dev/null | grep -q "Device $OPKG_IFACE attached (use_existing = true)"
}

# Dashboard statistics work when KeeneticOS polls the device counters (timestamp != 0)
ndm_stat_line() {
    ndm "show interface $NDM_IFACE stat" | awk -F': *' '
        /^ *rxbytes:/ {r=$2} /^ *txbytes:/ {t=$2} /^ *timestamp:/ {s=$2}
        END {printf "rxbytes=%s txbytes=%s timestamp=%s", r, t, s}'
}
stats_working() {
    case "$(ndm_stat_line)" in
        *"timestamp=0.000000"*|*"timestamp=") return 1 ;;
        *) return 0 ;;
    esac
}

toml_get() {  # $1 = key inside [listener.tun]
    awk -v k="$1" '
        /^\[/ {insec = ($0 ~ /^\[listener\.tun\][[:space:]]*$/); next}
        insec && $0 ~ "^[[:space:]]*" k "[[:space:]]*=" {sub(/^[^=]*=[[:space:]]*/, ""); print; exit}
    ' "$CONFIG_FILE" 2>/dev/null
}

# Put device_name / use_existing / included_routes = [] right under [listener.tun];
# old values of these keys in that section are dropped (multi-line arrays too)
toml_enable_attach() {
    awk -v dev="$OPKG_IFACE" '
        skip { if ($0 ~ /\]/) skip = 0; next }
        /^\[/ {
            insec = ($0 ~ /^\[listener\.tun\][[:space:]]*$/)
            print
            if (insec) {
                print "device_name = \"" dev "\""
                print "use_existing = true"
                print "included_routes = []"
            }
            next
        }
        insec && /^[[:space:]]*(device_name|use_existing)[[:space:]]*=/ {next}
        insec && /^[[:space:]]*included_routes[[:space:]]*=/ {
            if ($0 ~ /\[/ && $0 !~ /\]/) skip = 1
            next
        }
        {print}
    ' "$1"
}

mode_conf_set() {  # $1 = key, $2 = value
    if grep -q "^$1=" "$MODE_CONF"; then
        sed -i "s|^$1=.*|$1=\"$2\"|" "$MODE_CONF"
    else
        printf '%s="%s"\n' "$1" "$2" >> "$MODE_CONF"
    fi
}

stop_service() {
    "$INIT_SCRIPT" stop >/dev/null 2>&1
    sleep 2
    # firmware builds without pkill: fall back to ps + kill
    if command -v pkill >/dev/null 2>&1; then
        pkill -f "S99trusttunnel watchdog" 2>/dev/null
    else
        for p in $(ps w | grep "[S]99trusttunnel watchdog" | awk '{print $1}'); do kill "$p" 2>/dev/null; done
    fi
    for p in $(pidof trusttunnel_client); do kill "$p" 2>/dev/null; done
    sleep 2
    for p in $(pidof trusttunnel_client); do kill -9 "$p" 2>/dev/null; done
}

install_guard() {
    cat > "$GUARD_SCRIPT" <<EOF
#!/bin/sh
# tt-stats boot guard: after boot, if attach mode is on and the VPN does not come
# up within 4 minutes, return to the classic mode automatically.
case "\$1" in
    start) ( $SELF guard ) </dev/null >/dev/null 2>&1 & ;;
esac
exit 0
EOF
    chmod +x "$GUARD_SCRIPT"
}

# --------------------------------------------------------------- commands ---

cmd_status() {
    ver=$(client_version)
    echo "tt-stats $TTS_VERSION"
    echo "Mode:                 $TT_MODE (interface $NDM_IFACE / device $OPKG_IFACE)"
    if [ -n "$ver" ]; then
        if version_ge "$ver" "$MIN_CLIENT_VERSION"; then s="supports attach mode"; else s="TOO OLD for attach mode (need >= $MIN_CLIENT_VERSION)"; fi
        echo "Client version:       $ver ($s)"
    else
        echo "Client version:       not installed"
    fi
    [ "$TT_MODE" = "tun" ] || { echo "Attach mode applies to TUN mode only."; return 0; }
    echo "Attach mode:          ${TUN_USE_EXISTING}"
    echo "Client config:        device_name=$(toml_get device_name) use_existing=$(toml_get use_existing) included_routes=$(toml_get included_routes)"
    case "$(auth_key_state)" in
        none) a="not used" ;; works) a="set, supported by this build" ;; ignored) a="set, but IGNORED by this build - see: tt-stats selftest" ;; noconfig) a="cannot tell (client config not readable)" ;; *) a="set, cannot tell (client binary not readable)" ;;
    esac
    echo "Auth key:             $a"
    echo "Kill switch (client): $(awk -F'= *' '/^killswitch_enabled/ {print $2; exit}' "$CONFIG_FILE" 2>/dev/null)"
    grep -q '^ensure_device()' "$INIT_SCRIPT" 2>/dev/null && i="supports attach mode" || i="classic only"
    echo "Init script:          $i"
    if ip link show "$OPKG_IFACE" >/dev/null 2>&1; then
        echo "Device $OPKG_IFACE:      present, carrier=$(cat /sys/class/net/"$OPKG_IFACE"/carrier 2>/dev/null)"
    else
        echo "Device $OPKG_IFACE:      absent"
    fi
    vpn_ok && v="OK" || v="NO RESPONSE"
    echo "VPN check:            $v"
    echo "KeeneticOS counters:  $(ndm_stat_line)"
    if stats_working; then
        echo "Dashboard statistics: WORKING"
    elif [ "$TUN_USE_EXISTING" = "yes" ]; then
        echo "Dashboard statistics: not yet — reboot the router once: tt-stats reboot"
    else
        echo "Dashboard statistics: off (classic mode) — enable: tt-stats enable"
    fi
    [ -f "$BACKUP_DIR/MD5SUMS" ] && echo "Classic backup:       $BACKUP_DIR"
    [ -x "$GUARD_SCRIPT" ] && echo "Boot guard:           installed"
    if [ -x "$MEMGUARD_INIT" ]; then mg_running && m="on, running" || m="on, NOT running"; else m="off (tt-stats memguard on)"; fi
    echo "Memory guard:         $m; free memory $(mem_avail) kB"
    echo "Updates:              $(upd_status_line)"
    return 0
}

# ---------------------------------------------------------- update check ---
# Tells the user that a newer release is out. Reads only the version number:
#  - latest release: the redirect of releases/latest (HEAD, not followed) -> .../tag/vX.Y.Z
#    (downloads nothing, so it does not count as a download);
#  - MIN_VERSION in the repository: older installations get an IMPORTANT note (serious fixes).
# Never downloads or runs anything. Upgrading stays manual: re-run install.sh.

is_ver() { echo "$1" | grep -qE '^[0-9]+(\.[0-9]+){0,3}$'; }   # only digits and dots get through

upd_latest() {
    loc=$(curl -sI -m 5 "$TTS_LATEST_URL" 2>/dev/null | tr -d '\r' | awk 'tolower($1)=="location:" {print $2; exit}')
    v="${loc##*/tag/v}"; is_ver "$v" && echo "$v"
}

upd_min() {
    v=$(curl -sf -m 5 "$TTS_MIN_URL" 2>/dev/null | head -n 1 | tr -d '\r \t')
    is_ver "$v" && echo "$v"
}

upd_message() {  # $1 = latest, $2 = yes if important
    m="update available: tt-stats $TTS_VERSION -> $1"
    [ "$2" = yes ] && m="IMPORTANT $m (fixes a serious bug, see CHANGELOG)"
    echo "$m. To upgrade, re-run install.sh (the VPN restarts for 5-10 s). https://github.com/$TTS_GH_REPO/releases"
}

cmd_update_check() {  # $1 = --quiet | --install-cron | --remove-cron
    case "$1" in
        --install-cron)
            [ -d "$(dirname "$UPD_CRON")" ] || { echo "No $(dirname "$UPD_CRON") (Entware cron) - daily check not installed; tt-stats status still checks."; return 0; }
            cat > "$UPD_CRON" <<'EOF'
#!/bin/sh
# tt-stats: once a day, check whether a newer release is out (reads only the version number,
# downloads and changes nothing). Remove this file to turn the check off.
( sleep "$(awk 'BEGIN { srand(); print int(rand() * 1800) }')"; /opt/bin/tt-stats update-check --quiet ) </dev/null >/dev/null 2>&1 &
EOF
            chmod +x "$UPD_CRON"; echo "Daily update check installed: $UPD_CRON"; return 0 ;;
        --remove-cron) rm -f "$UPD_CRON"; echo "Daily update check removed."; return 0 ;;
    esac
    if [ "$(auth_key_state)" = ignored ]; then   # once a day, together with the update check
        m="WARNING: client_random_auth_key is set, but this client build ignores it (no SSL_set_custom_client_random). A server with a deny rule will drop this router. Run: tt-stats selftest"
        logger -p warn -t tt-stats "$m" 2>/dev/null; echo "$(ts) $m" >> "$LOG"
        [ "$1" = --quiet ] || echo "$m"
    fi
    lv=$(upd_latest)
    if [ -z "$lv" ]; then [ "$1" = --quiet ] || echo "Could not reach GitHub - try later."; return 0; fi
    mv_=$(upd_min); imp=no
    [ -n "$mv_" ] && ! version_ge "$TTS_VERSION" "$mv_" && imp=yes
    if version_ge "$TTS_VERSION" "$lv"; then st=current; else st=available; fi
    echo "$(date +%s) $lv $imp $st" > "$UPD_CACHE"
    if [ "$st" = available ]; then
        msg=$(upd_message "$lv" "$imp")
        if [ "$(cat "$UPD_NOTIFIED" 2>/dev/null)" != "$lv" ]; then   # router log: once per new version
            logger -t tt-stats "$msg" 2>/dev/null; echo "$(ts) $msg" >> "$LOG"
            mkdir -p "$(dirname "$UPD_NOTIFIED")"; echo "$lv" > "$UPD_NOTIFIED"
        fi
        [ "$1" = --quiet ] || echo "$msg"
    else
        [ "$1" = --quiet ] || echo "tt-stats $TTS_VERSION is the latest release."
    fi
}

upd_status_line() {  # uses the cached result; checks again if it is older than a day
    set -- $(cat "$UPD_CACHE" 2>/dev/null)
    if [ -z "$1" ] || [ $(( $(date +%s) - $1 )) -gt 86400 ]; then
        cmd_update_check --quiet; set -- $(cat "$UPD_CACHE" 2>/dev/null)
    fi
    if [ -z "$2" ]; then echo "unknown (GitHub not reachable)"
    elif [ "$4" = available ] && [ "$3" = yes ]; then echo "IMPORTANT update $2 - re-run install.sh"
    elif [ "$4" = available ]; then echo "$2 available - re-run install.sh"
    else echo "up to date"; fi
}

# ---------------------------------------------------------- memory guard ---
# On routers with 128 MB of RAM a long fast download through the tunnel can exhaust
# memory (the client buffers faster than the CPU encrypts) and the router hangs.
# The guard restarts only the client (frees its buffers); 3 times in 10 minutes and
# memory is still critical -> the VPN pauses for 15 minutes and starts again. A short
# outage beats a hung router. A small client is not restarted: then something else
# eats the memory and a restart would only break connections.

mem_avail() { awk '/MemAvailable/ {print $2; exit}' /proc/meminfo; }
# The client's memory: RAM plus swap. Under zram a bloated client is pushed out to swap and looks tiny
# by RSS alone (a real night: 0.7 MB in RAM, 21 MB in swap, and the VPN stood still).
client_rss() { p=$(pidof trusttunnel_client | cut -d' ' -f1); [ -n "$p" ] && awk '/^VmRSS:/ {r = $2} /^VmSwap:/ {w = $2} END {if (r != "") print r + w}' "/proc/$p/status"; }
load1() { cut -d' ' -f1 "${LOADAVG_FILE:-/proc/loadavg}" | cut -d. -f1; }   # file overridable for tests

# Overload brake. When the VPN drops, devices behind a kill switch retry DNS without a pause:
# thousands of short UDP conntrack entries, the kernel swaps, the load goes to 50+ and the
# router hangs. Restarting the client does not help here. Instead: stop heavy optional jobs
# and let short UDP entries expire in 5 s instead of 30 s for 10 minutes (UDP streams that
# keep sending, e.g. QUIC or calls, use a separate timeout and are not affected).
mg_brake() {  # $1 = load, $2 = free kB
    mlog "BRAKE: overload - load $1, free $2 kB for 2 minutes: stopping ${MEMGUARD_SHED:-nothing}, UDP conntrack timeout 5 s for 10 minutes"
    for n in $MEMGUARD_SHED; do
        for p in $(ps w | awk -v n="$n" -v me="$$" 'index($0, n) && $1 != me && !/awk/ {print $1}'); do
            # children first (a shell waiting for curl would otherwise finish that call first)
            # shellcheck disable=SC2013  # PIDs are single words
            for c in $(awk -v pp="$p" '$4 == pp {print $1}' /proc/[0-9]*/stat 2>/dev/null); do kill "$c" 2>/dev/null; done
            kill "$p" 2>/dev/null && mlog "stopped: $n (pid $p)"
        done
    done
    if [ -w "$UDP_TIMEOUT_FILE" ] && [ ! -f "$MEMGUARD_UDPT" ]; then
        cat "$UDP_TIMEOUT_FILE" > "$MEMGUARD_UDPT"; echo 5 > "$UDP_TIMEOUT_FILE"
        ( sleep 600; cat "$MEMGUARD_UDPT" > "$UDP_TIMEOUT_FILE"; rm -f "$MEMGUARD_UDPT" ) </dev/null >/dev/null 2>&1 &
    fi
}
# Black box: everything needed to name the culprit of a bad evening afterwards — memory (RAM and swap:
# under zram a big process looks small), kernel memory and /tmp, CPU, connections per device (DNS, UDP),
# where the connections go, traffic per interface, kernel warnings. Once a minute while memory is low or the
# load is high, plus once an hour as a baseline of a normal state. Light: no ndmc calls.
MEMGUARD_BOX_NET="/tmp/tt-blackbox.net"   # interface counters of the previous snapshot
mg_blackbox() {  # $1 = free kB, $2 = load, $3 = note
    [ -f "$MEMGUARD_BOX" ] && [ "$(wc -c < "$MEMGUARD_BOX")" -gt 500000 ] && mv "$MEMGUARD_BOX" "$MEMGUARD_BOX.old"
    # shellcheck disable=SC2016  # awk programs
    {
        echo "$(ts) $3free $1 kB, load $2, swap used $(awk '/SwapTotal/ {t = $2} /SwapFree/ {f = $2} END {print t - f}' /proc/meminfo) kB, connections $(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null), processes $(ls -d /proc/[0-9]* | wc -l)"
        awk '/^(MemFree|Cached|Shmem|Slab|SUnreclaim):/ {sub(":", "", $1); printf " %s %s", $1, $2} END {print " kB"}' /proc/meminfo | sed 's/^/  kernel  /'
        df /tmp 2>/dev/null | awk 'NR > 1 {print "  /tmp    " $3 " kB in RAM"}'
        echo "  memory: RAM + swap, pid, name"
        cat /proc/[0-9]*/status 2>/dev/null | awk '/^Name:/ {n = $2; r = 0} /^Pid:/ {p = $2} /^VmRSS:/ {r = $2} /^VmSwap:/ {print r + $2, r, $2, p, n}' |
            sort -rn | head -6 | awk '{printf "    %6d kB = %d + %d  %s %s\n", $1, $2, $3, $4, $5}'
        echo "  cpu: $(top -bn1 2>/dev/null | awk 'NR == 2 {sub(/^CPU: */, ""); print}')"
        top -bn1 2>/dev/null | awk 'NR > 4 && NR <= 10 {printf "    %5s  %s %s %s\n", $8, $1, $9, $10}'
        if [ -r /proc/net/nf_conntrack ] && [ "$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)" -le 4000 ] 2>/dev/null; then
            echo "  connections per device: total, DNS, UDP, ip, mac"
            awk '{s = ""; d = ""; for (i = 1; i <= NF; i++) {if (s == "" && $i ~ /^src=/) s = substr($i, 5); if (d == "" && $i ~ /^dport=/) d = substr($i, 7)}
                  t[s]++; if (d == 53) n[s]++; if ($3 == "udp") u[s]++}
                  END {for (k in t) print t[k], n[k] + 0, u[k] + 0, k}' /proc/net/nf_conntrack | sort -rn | head -6 |
                while read -r c d u ip; do printf '    %5d %5d %5d  %s %s\n' "$c" "$d" "$u" "$ip" "$(awk -v ip="$ip" '$1 == ip {print $4}' /proc/net/arp)"; done
            echo "  where to: count, address:port"
            awk '{d = ""; p = ""; for (i = 1; i <= NF; i++) {if (d == "" && $i ~ /^dst=/) d = substr($i, 5); if (p == "" && $i ~ /^dport=/) p = substr($i, 7)} print d ":" p}' /proc/net/nf_conntrack |
                sort | uniq -c | sort -rn | head -4 | awk '{printf "    %5d  %s\n", $1, $2}'
        fi
        # traffic since the previous snapshot, kB/s per interface
        now=$(date +%s)
        awk -v now="$now" 'NR > 2 {sub(":", " "); print $1, $2, $10, now}' /proc/net/dev > "$MEMGUARD_BOX_NET.new"
        [ -f "$MEMGUARD_BOX_NET" ] && awk 'NR == FNR {rx[$1] = $2; tx[$1] = $3; t = $4; next}
            ($1 in rx) && $4 > t {r = ($2 - rx[$1]) / ($4 - t) / 1024; x = ($3 - tx[$1]) / ($4 - t) / 1024; if (r + x >= 1) printf "%d %s in %d out %d kB/s\n", r + x, $1, r, x}' \
            "$MEMGUARD_BOX_NET" "$MEMGUARD_BOX_NET.new" | sort -rn | head -4 | cut -d' ' -f2- | sed 's/^/  traffic /'
        mv "$MEMGUARD_BOX_NET.new" "$MEMGUARD_BOX_NET"
        # new kernel warnings only (dmesg keeps old ones and has no wall-clock time here)
        dmesg 2>/dev/null | grep -iE 'out of memory|killed process|allocation fail|table full|dropping packet' | tail -5 > "$MEMGUARD_BOX_NET.k"
        [ -f "$MEMGUARD_BOX_NET.kold" ] || : > "$MEMGUARD_BOX_NET.kold"
        awk 'FILENAME == ARGV[1] {seen[$0] = 1; next} !($0 in seen)' "$MEMGUARD_BOX_NET.kold" "$MEMGUARD_BOX_NET.k" | sed 's/^/  kernel! /'
        mv "$MEMGUARD_BOX_NET.k" "$MEMGUARD_BOX_NET.kold"
    } >> "$MEMGUARD_BOX" 2>/dev/null
}

# The PID file survives a crash on the USB drive; after a reboot that PID may belong to another
# process, so check the command line, not just that the PID exists.
DNSLIM_CH=TTDNSLIM
dnslim_drop() {  # $1 = iptables|ip6tables → the limit rule inside the chain (old firmware has connlimit, not hashlimit)
    [ "$1" = ip6tables ] && m=128 || m=32
    echo "-m connlimit --connlimit-above $DNSLIM_MAX --connlimit-mask $m -j DROP"
}
dnslim_jump() { echo "-i $DNSLIM_IF -p udp --dport 53 -j $DNSLIM_CH"; }
dnslim_exempts() {  # $1 = iptables|ip6tables → the exempt addresses of this family
    for x in $DNSLIM_EXEMPT; do case "$x" in *:*) [ "$1" = ip6tables ] && echo "$x" ;; *) [ "$1" = iptables ] && echo "$x" ;; esac; done
}
DNSLIM_NO6=/tmp/tt-dnslim.no6   # IPv6 limit could not be set (no connlimit for ip6tables in this firmware)
dnslim_present() {  # in every family: the jump, exactly the current exemptions, and the limit with the current number last
    for T in iptables ip6tables; do
        command -v $T >/dev/null 2>&1 || continue
        [ $T = ip6tables ] && [ -f "$DNSLIM_NO6" ] && continue
        $T -w -C INPUT $(dnslim_jump) 2>/dev/null || return 1
        for x in $(dnslim_exempts $T); do $T -w -C $DNSLIM_CH -s "$x" -j RETURN 2>/dev/null || return 1; done
        r=$($T -w -S $DNSLIM_CH 2>/dev/null | grep '^-A ')
        [ "$(echo "$r" | grep -c .)" -eq $(( $(dnslim_exempts $T | wc -l) + 1 )) ] || return 1
        echo "$r" | tail -1 | grep -q -- "--connlimit-above $DNSLIM_MAX .*-j DROP" || return 1
    done
}
dnslim_remove() {  # takes our chain out, whatever limit and exemptions it was made with
    for T in iptables ip6tables; do
        command -v $T >/dev/null 2>&1 || continue
        $T -w -S INPUT 2>/dev/null | grep -e "-j $DNSLIM_CH\$" | sed 's/^-A /-D /' | while read -r r; do eval "$T -w $r" 2>/dev/null; done
        $T -w -F $DNSLIM_CH 2>/dev/null; $T -w -X $DNSLIM_CH 2>/dev/null
    done
    rm -f "$DNSLIM_NO6"
}
dnslim_apply() {  # silent drop of a device's DNS requests beyond DNSLIM_MAX open ones: a DNS storm cannot eat the router any more
    [ "$DNSLIM_MAX" -gt 0 ] 2>/dev/null || { dnslim_remove; return 0; }   # 0 = off: nothing of ours may stay behind
    command -v iptables >/dev/null 2>&1 || return 0
    dnslim_present && return 0   # rebuilding a working chain would reset what connlimit counts
    dnslim_remove
    for T in iptables ip6tables; do
        command -v $T >/dev/null 2>&1 || continue
        $T -w -N $DNSLIM_CH 2>/dev/null || continue
        for x in $(dnslim_exempts $T); do $T -w -A $DNSLIM_CH -s "$x" -j RETURN 2>/dev/null; done
        if ! $T -w -A $DNSLIM_CH $(dnslim_drop $T) 2>/dev/null; then
            # this family cannot do it: leave no half-made chain, and do not rebuild the working one every minute
            $T -w -F $DNSLIM_CH 2>/dev/null; $T -w -X $DNSLIM_CH 2>/dev/null
            [ $T = ip6tables ] && : > "$DNSLIM_NO6"
            continue
        fi
        $T -w -I INPUT 1 $(dnslim_jump) 2>/dev/null
    done
}
dnslim_dropped() { iptables -w -L $DNSLIM_CH -v -n -x 2>/dev/null | awk '$3 == "DROP" {n += $1} END {print n + 0}'; }
mg_running() { p=$(cat "$MEMGUARD_PID" 2>/dev/null); [ -n "$p" ] && grep -q memguard-run "/proc/$p/cmdline" 2>/dev/null; }
mlog() { mkdir -p "$(dirname "$MEMGUARD_LOG")"; echo "$(ts) $*" >> "$MEMGUARD_LOG"; logger -t tt-memguard "$*" 2>/dev/null; }

mg_start() {
    mg_running && return 0
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -x "$SELF" -- memguard-run
    else
        ( "$SELF" memguard-run ) </dev/null >/dev/null 2>&1 &
    fi
    sleep 1
}

mg_stop() {
    mg_running && kill "$(cat "$MEMGUARD_PID")" 2>/dev/null
    rm -f "$MEMGUARD_PID"
}

cmd_memguard_run() {
    echo $$ > "$MEMGUARD_PID"
    # The trap runs only after the current sleep; by then a new guard may own the PID file
    trap '[ "$(cat "$MEMGUARD_PID" 2>/dev/null)" = "$$" ] && rm -f "$MEMGUARD_PID"; exit 0' TERM INT
    mlog "started: threshold ${MEMGUARD_LOW_KB} kB, now free $(mem_avail) kB"
    [ -f "$MEMGUARD_UDPT" ] && { cat "$MEMGUARD_UDPT" > "$UDP_TIMEOUT_FILE"; rm -f "$MEMGUARD_UDPT"; }   # restore after a crash
    hot=0; braked=0; boxed=0; bchk=0; bloated=0; dchk=0; bgap=$MEMGUARD_BLOAT_GAP
    # Less swapping: under zram a swapped page still costs RAM and CPU; only ever lower the value
    if [ "$MEMGUARD_SWAPPINESS" -gt 0 ] 2>/dev/null && [ -w "$SWAPPINESS_FILE" ]; then
        s=$(cat "$SWAPPINESS_FILE" 2>/dev/null)
        [ "${s:-0}" -gt "$MEMGUARD_SWAPPINESS" ] && echo "$MEMGUARD_SWAPPINESS" > "$SWAPPINESS_FILE" && mlog "swappiness $s -> $MEMGUARD_SWAPPINESS"
    fi
    dnslim_apply
    while true; do
        a=$(mem_avail)
        if [ "$MEMGUARD_BOX_LOAD" -gt 0 ] 2>/dev/null; then
            l=$(load1); now=$(date +%s)
            if { [ "${a:-999999}" -lt $((MEMGUARD_LOW_KB * 3 / 2)) ] || [ "${l:-0}" -ge "$MEMGUARD_BOX_LOAD" ]; } && [ $((now - boxed)) -ge 60 ]; then
                mg_blackbox "$a" "$(cut -d' ' -f1-3 "${LOADAVG_FILE:-/proc/loadavg}")" ""; boxed=$now
            elif [ $((now - boxed)) -ge 3600 ]; then
                mg_blackbox "$a" "$(cut -d' ' -f1-3 "${LOADAVG_FILE:-/proc/loadavg}")" "(hourly, normal) "; boxed=$now
            fi
        fi
        if [ "$MEMGUARD_LOAD" -gt 0 ] 2>/dev/null; then
            l=$(load1); now=$(date +%s)
            # 1.5x the threshold: free memory jumps around under a storm (14 -> 16 MB) and must not reset the count
            if [ "${a:-999999}" -lt $((MEMGUARD_LOW_KB * 3 / 2)) ] && [ "${l:-0}" -ge "$MEMGUARD_LOAD" ]; then
                [ "$hot" = 0 ] && hot=$now
                if [ $((now - hot)) -ge 120 ] && [ $((now - braked)) -ge 600 ]; then
                    mg_brake "$l" "$a"; braked=$now
                fi
            else
                hot=0
            fi
        fi
        if [ "${a:-999999}" -lt "$MEMGUARD_LOW_KB" ] && [ ! -f "$MEMGUARD_PAUSE" ]; then
            now=$(date +%s)
            { awk -v n="$now" 'n-$1<600' "$MEMGUARD_HIST" 2>/dev/null; echo "$now"; } > "$MEMGUARD_HIST.new"
            mv "$MEMGUARD_HIST.new" "$MEMGUARD_HIST"
            recent=$(wc -l < "$MEMGUARD_HIST")
            r=$(client_rss)   # read once: the client may be restarting right now
            if [ "$recent" -ge 3 ] && [ "$a" -lt "$MEMGUARD_CRIT_KB" ]; then
                mlog "PAUSE the VPN for 15 minutes: free ${a} kB, client ${r:-?} kB, ${recent} times in 10 minutes"
                touch "$MEMGUARD_PAUSE"; "$MG_TARGET" stop >/dev/null 2>&1
                ( sleep 900; rm -f "$MEMGUARD_PAUSE"; "$MG_TARGET" start >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
            elif [ "$recent" -ge 3 ]; then
                mlog "not restarting again: ${recent} low-memory readings in 10 minutes, restarting does not help; the VPN is paused only below ${MEMGUARD_CRIT_KB} kB (free ${a} kB, client ${r:-?} kB)"
            elif [ -z "$r" ]; then
                mlog "not restarting: the client is not running right now (free ${a} kB)"
            elif [ "$r" -lt "$MEMGUARD_SMALL_KB" ]; then
                mlog "not restarting: the client is small (${r} kB), free ${a} kB - something else eats the memory"
            else
                mlog "restarting the client: free ${a} kB, client ${r} kB (${recent} in 10 minutes)"
                "$MG_TARGET" reload >/dev/null 2>&1
            fi
            sleep 60
        fi
        # A client that has grown a lot is restarted early, while there is still memory: 27 MB of it
        # (mostly in swap) was what pulled the router down on the evening of 14.10
        if [ "$MEMGUARD_BLOAT_KB" -gt 0 ] 2>/dev/null && [ ! -f "$MEMGUARD_PAUSE" ]; then
            now=$(date +%s)
            if [ $((now - bchk)) -ge 30 ]; then
                bchk=$now; r=$(client_rss)
                if [ -n "$r" ] && [ "$r" -gt "$MEMGUARD_BLOAT_KB" ] && [ $((now - bloated)) -ge "$bgap" ]; then
                    mlog "restarting the client early: it grew to ${r} kB (RAM + swap), limit ${MEMGUARD_BLOAT_KB} kB, free $(mem_avail) kB"
                    "$MG_TARGET" reload >/dev/null 2>&1; bloated=$now
                    # a client that is simply big on this router must not be restarted every half hour forever
                    [ "$bgap" -lt 14400 ] && bgap=$((bgap * 2))
                fi
            fi
        fi
        # The firmware sometimes rebuilds the filter table without the netfilter.d hook putting the
        # DNS limit back (a real reboot left the router without it): check once a minute
        if [ "$DNSLIM_MAX" -gt 0 ] 2>/dev/null; then
            now=$(date +%s)
            if [ $((now - dchk)) -ge 60 ]; then
                dchk=$now
                if command -v iptables >/dev/null 2>&1 && ! dnslim_present; then
                    dnslim_apply
                    dnslim_present && mlog "DNS limit was missing from the firewall - put it back"
                fi
            fi
        fi
        sleep 5
    done
}

cmd_memguard_nightly() {  # from cron.daily: restart a bloated client while nobody uses the VPN
    [ "$MEMGUARD_NIGHT_KB" -gt 0 ] 2>/dev/null || return 0
    [ -f "$MEMGUARD_PAUSE" ] && return 0
    r=$(client_rss)
    [ -n "$r" ] && [ "$r" -gt "$MEMGUARD_NIGHT_KB" ] || return 0
    mlog "nightly restart: client ${r} kB > ${MEMGUARD_NIGHT_KB} kB, free $(mem_avail) kB"
    "$MG_TARGET" reload >/dev/null 2>&1
}

cmd_memguard() {  # $1 = on|off|status, $2 = threshold kB (optional, with on)
    case "$1" in
        on)
            [ -n "$(mem_avail)" ] || die "this firmware does not report MemAvailable in /proc/meminfo"
            if [ -n "$2" ]; then
                case "$2" in *[!0-9]*) die "threshold must be a number of kB, e.g. 15000" ;; esac
                mode_conf_set MEMGUARD_LOW_KB "$2"; MEMGUARD_LOW_KB="$2"
            fi
            mkdir -p "$(dirname "$MEMGUARD_INIT")" "$(dirname "$MEMGUARD_PID")"
            cat > "$MEMGUARD_INIT" <<EOF
#!/bin/sh
# tt-stats memory guard: restarts the TrustTunnel client when free memory runs out,
# instead of letting a 128 MB router hang. Managed by: tt-stats memguard on|off
case "\$1" in
    start)   $SELF memguard-start ;;
    restart) $SELF memguard-stop; $SELF memguard-start ;;
    stop)          $SELF memguard-stop ;;
esac
exit 0
EOF
            chmod +x "$MEMGUARD_INIT"
            if [ -d "$(dirname "$MEMGUARD_CRON")" ]; then
                cat > "$MEMGUARD_CRON" <<EOF
#!/bin/sh
# tt-stats memory guard: once a night restart the TrustTunnel client if it has grown
# above MEMGUARD_NIGHT_KB (mode.conf, 0 = off). Managed by: tt-stats memguard on|off
$SELF memguard-nightly </dev/null >/dev/null 2>&1
EOF
                chmod +x "$MEMGUARD_CRON"
            fi
            # The firmware rebuilds the filter table now and then: the hook puts the DNS limit back each time
            if [ "$DNSLIM_MAX" -gt 0 ] 2>/dev/null && [ -d "$(dirname "$DNSLIM_HOOK")" ]; then
                printf '#!/bin/sh\n# tt-stats: DNS limit per device (DNSLIM_MAX in mode.conf, 0 = off). Managed by: tt-stats memguard on|off\n[ "$table" = filter ] && %s dnslimit-apply >/dev/null 2>&1\nexit 0\n' "$SELF" > "$DNSLIM_HOOK"
                chmod +x "$DNSLIM_HOOK"
            else
                rm -f "$DNSLIM_HOOK"
            fi
            dnslim_remove   # the guard puts the rules back at its start, with the current rate (or none if it is 0)
            mg_stop; mg_start
            mg_running && say "Memory guard is on: threshold ${MEMGUARD_LOW_KB} kB (now free $(mem_avail) kB). Log: $MEMGUARD_LOG" \
                       || die "memory guard did not start, see $MEMGUARD_LOG"
            ;;
        off)
            mg_stop; rm -f "$MEMGUARD_INIT" "$MEMGUARD_PAUSE" "$MEMGUARD_CRON" "$DNSLIM_HOOK"; dnslim_remove
            say "Memory guard is off"
            ;;
        *)
            echo "Router memory: $((${MEM_TOTAL_KB:-0} / 1024)) MB — defaults for ${MG_TIER} MB routers (values in mode.conf win)"
            if [ -x "$MEMGUARD_INIT" ]; then echo "Memory guard: on (threshold ${MEMGUARD_LOW_KB} kB, pause below ${MEMGUARD_CRIT_KB} kB, small client < ${MEMGUARD_SMALL_KB} kB)$(mg_running && echo ', running' || echo ', NOT running')"
                if [ -x "$MEMGUARD_CRON" ] && [ "$MEMGUARD_NIGHT_KB" -gt 0 ] 2>/dev/null; then echo "Nightly restart: if the client is above ${MEMGUARD_NIGHT_KB} kB"; else echo "Nightly restart: off"; fi
                if [ "$MEMGUARD_LOAD" -gt 0 ] 2>/dev/null; then echo "Overload brake: load >= ${MEMGUARD_LOAD} and free < $((MEMGUARD_LOW_KB * 3 / 2)) kB for 2 minutes"; else echo "Overload brake: off"; fi
                if [ "$MEMGUARD_BLOAT_KB" -gt 0 ] 2>/dev/null; then echo "Early restart: client above ${MEMGUARD_BLOAT_KB} kB (RAM + swap), at most once per $((MEMGUARD_BLOAT_GAP / 60)) minutes (the gap doubles after each one, up to 4 hours)"; else echo "Early restart: off"; fi
                if [ "$DNSLIM_MAX" -gt 0 ] 2>/dev/null; then
                    if dnslim_present; then echo "DNS limit: ${DNSLIM_MAX} open requests per device, dropped so far: $(dnslim_dropped)${DNSLIM_EXEMPT:+; without the limit: $DNSLIM_EXEMPT}"
                    else echo "DNS limit: ${DNSLIM_MAX} open requests per device (rule NOT in the firewall)"; fi
                else echo "DNS limit: off"; fi
                echo "Swappiness: $(cat "$SWAPPINESS_FILE" 2>/dev/null)"
                [ -f "$MEMGUARD_UDPT" ] && echo "Brake is on now: UDP conntrack timeout 5 s (back to $(cat "$MEMGUARD_UDPT") s within 10 minutes)"
            else echo "Memory guard: off — enable: tt-stats memguard on"; fi
            echo "Free memory:  $(mem_avail) kB; client: $(client_rss) kB (RAM + swap)"
            [ -f "$MEMGUARD_PAUSE" ] && echo "VPN is paused by the guard (starts again within 15 minutes)"
            [ -f "$MEMGUARD_LOG" ] && { echo "Last events:"; tail -n 5 "$MEMGUARD_LOG"; }
            [ -s "$MEMGUARD_BOX" ] && echo "Black box (who used memory and connections): $(grep -c '^[0-9]' "$MEMGUARD_BOX") snapshots, last $(grep '^[0-9]' "$MEMGUARD_BOX" | tail -1 | cut -c1-19) — $MEMGUARD_BOX"
            ;;
    esac
}

cmd_disable() {  # $1 = reason
    [ -f "$BACKUP_DIR/MD5SUMS" ] || die "no backup in $BACKUP_DIR — nothing to restore"
    touch "$DONE_FLAG"
    say "=== Returning to the classic mode. Reason: ${1:-manual}"
    stop_service
    cp "$BACKUP_DIR/S99trusttunnel" "$INIT_SCRIPT" && chmod +x "$INIT_SCRIPT"
    cp "$BACKUP_DIR/trusttunnel_client.toml" "$CONFIG_FILE"
    cp "$BACKUP_DIR/mode.conf" "$MODE_CONF"
    # the WAN hook is not put back: the current one works in both modes and has the later fixes
    if (cd / && grep -v '010-trusttunnel.sh' "$BACKUP_DIR/MD5SUMS" | md5sum -c >/dev/null 2>&1); then
        say "Backup files restored (checksums OK)"
    else
        say "WARNING: restored files do not match the backup checksums"
    fi
    # shellcheck source=/dev/null
    . "$MODE_CONF"
    TUN_USE_EXISTING="no"
    "$INIT_SCRIPT" start >/dev/null 2>&1
    if wait_vpn 120; then say "Classic mode is back, VPN works"; rm -f "$GUARD_SCRIPT"; return 0; fi
    say "VPN did not respond in 120 s — restarting once more"
    "$INIT_SCRIPT" restart >/dev/null 2>&1
    if wait_vpn 120; then say "Classic mode is back, VPN works"; rm -f "$GUARD_SCRIPT"; return 0; fi
    say "VPN still does not respond (maybe no connection to the server at all). Classic files are in place; the watchdog keeps retrying."
    rm -f "$GUARD_SCRIPT"
    return 1
}

cmd_enable() {  # $1 = --reboot (optional)
    [ "$TT_MODE" = "tun" ] || die "attach mode needs TUN mode (TT_MODE=tun in $MODE_CONF)"
    [ -f "$CONFIG_FILE" ] || die "$CONFIG_FILE not found"
    grep -q '^\[listener\.tun\]' "$CONFIG_FILE" || die "no [listener.tun] section in $CONFIG_FILE"
    ver=$(client_version) || die "client not found: $CLIENT_BIN"
    version_ge "$ver" "$MIN_CLIENT_VERSION" || die "client $ver is too old, need >= $MIN_CLIENT_VERSION (update the client first)"
    ndm "show interface $NDM_IFACE" | grep -q "id: $NDM_IFACE" || die "interface $NDM_IFACE not found in KeeneticOS"

    if [ "$TUN_USE_EXISTING" = "yes" ]; then
        say "Attach mode is already on."
        if stats_working; then say "Dashboard statistics: WORKING"; else say "Statistics start after one router reboot: tt-stats reboot"; fi
        [ "$1" = "--reboot" ] && cmd_reboot
        return 0
    fi

    vpn_ok || die "the VPN does not work right now — fix it first, otherwise the switch cannot be verified"

    # 1. Backup of the working classic setup
    mkdir -p "$BACKUP_DIR"
    cp "$INIT_SCRIPT" "$BACKUP_DIR/S99trusttunnel"
    cp "$CONFIG_FILE" "$BACKUP_DIR/trusttunnel_client.toml"
    cp "$MODE_CONF" "$BACKUP_DIR/mode.conf"
    [ -f "$WAN_HOOK" ] && cp "$WAN_HOOK" "$BACKUP_DIR/010-trusttunnel.sh"
    chmod 600 "$BACKUP_DIR/trusttunnel_client.toml"
    files="$INIT_SCRIPT $CONFIG_FILE $MODE_CONF"
    [ -f "$WAN_HOOK" ] && files="$files $WAN_HOOK"
    # shellcheck disable=SC2086
    md5sum $files > "$BACKUP_DIR/MD5SUMS"
    say "=== Switching to attach mode (client $ver). Backup: $BACKUP_DIR"

    # 2. New files are prepared BEFORE touching the running service
    work=$(mktemp -d /tmp/tt-stats.XXXXXX)
    if ! grep -q '^ensure_device()' "$INIT_SCRIPT"; then
        say "Downloading attach-capable S99trusttunnel and 010-trusttunnel.sh..."
        curl -fsSL "$TTS_REPO_URL/S99trusttunnel" -o "$work/S99trusttunnel" || die "download of S99trusttunnel failed"
        curl -fsSL "$TTS_REPO_URL/010-trusttunnel.sh" -o "$work/010-trusttunnel.sh" || die "download of 010-trusttunnel.sh failed"
        sh -n "$work/S99trusttunnel" || die "downloaded S99trusttunnel is invalid"
        grep -q '^ensure_device()' "$work/S99trusttunnel" || die "downloaded S99trusttunnel has no attach support"
        sh -n "$work/010-trusttunnel.sh" || die "downloaded 010-trusttunnel.sh is invalid"
    fi
    toml_enable_attach "$CONFIG_FILE" > "$work/trusttunnel_client.toml"
    for want in "^device_name = \"$OPKG_IFACE\"" '^use_existing = true' '^included_routes = \[\]'; do
        grep -q "$want" "$work/trusttunnel_client.toml" || die "could not prepare the client config ($want)"
    done
    mtu=$(toml_get mtu_size | tr -dc '0-9'); [ -n "$mtu" ] || mtu=1280

    # 3. Dead man's switch: if this run does not report success within 10 minutes — roll back
    rm -f "$DONE_FLAG"
    ( sleep 600; [ -f "$DONE_FLAG" ] || "$SELF" disable "safety timer: the switch did not finish in 10 minutes" ) </dev/null >/dev/null 2>&1 &

    # 4. Switch
    stop_service
    [ -f "$work/S99trusttunnel" ] && cp "$work/S99trusttunnel" "$INIT_SCRIPT" && chmod +x "$INIT_SCRIPT"
    [ -f "$work/010-trusttunnel.sh" ] && cp "$work/010-trusttunnel.sh" "$WAN_HOOK" && chmod +x "$WAN_HOOK"
    cp "$work/trusttunnel_client.toml" "$CONFIG_FILE"
    rm -rf "$work"
    mode_conf_set TUN_MTU "$mtu"
    cur_mtu=$(ndm "show running-config" | awk -v i="interface $NDM_IFACE" '$0 == i {f = 1; next} f && /^!/ {exit} f && $1 == "ip" && $2 == "mtu" {print $3; exit}')
    if [ "$cur_mtu" != "$mtu" ]; then
        # KeeneticOS applies its own MTU to its device: keep it equal to the client mtu_size
        ndmc -c "interface $NDM_IFACE ip mtu $mtu" >/dev/null 2>&1
        ndmc -c "system configuration save" >/dev/null 2>&1
    fi
    install_guard
    TUN_USE_EXISTING=yes
    t0=$(date +%s)
    "$INIT_SCRIPT" start >/dev/null 2>&1

    # 5. Verify: VPN up within 90 s, client attached, stable for 60 s
    wait_vpn 90 || { cmd_disable "VPN did not come up in attach mode within 90 s"; exit 1; }
    client_attached || { cmd_disable "client did not attach to $OPKG_IFACE"; exit 1; }
    say "VPN is up in attach mode after $(( $(date +%s) - t0 )) s, checking stability for 60 s..."
    for i in 1 2 3; do
        sleep 20
        vpn_ok || { cmd_disable "VPN dropped within the first minute (check $i)"; exit 1; }
    done
    touch "$DONE_FLAG"
    say "SUCCESS: attach mode is on. MTU $mtu, boot guard installed."
    if stats_working; then
        say "Dashboard statistics: WORKING"
    else
        say "Dashboard statistics start after one router reboot (KeeneticOS recreates its own $OPKG_IFACE): tt-stats reboot"
        [ "$1" = "--reboot" ] && cmd_reboot
    fi
    return 0
}

# The checks are evaluated later, so single quotes are intended here.
# shellcheck disable=SC2016
cmd_reboot() {
    bad=0
    chk() { if eval "$2"; then say "  ok   $1"; else say "  FAIL $1"; bad=1; fi; }
    say "=== Pre-flight checks before reboot"
    chk "attach mode is on"                 '[ "$TUN_USE_EXISTING" = "yes" ]'
    chk "init script supports attach mode"  'grep -q "^ensure_device()" "$INIT_SCRIPT"'
    chk "client config has use_existing"    'grep -q "^use_existing = true" "$CONFIG_FILE"'
    chk "VPN works now"                     'vpn_ok'
    if [ -x "$GUARD_SCRIPT" ]; then   # the switch from the classic mode is not confirmed yet: the way back must be ready
        chk "classic backup is intact"      '[ -f "$BACKUP_DIR/MD5SUMS" ] && [ -f "$BACKUP_DIR/S99trusttunnel" ] && [ -f "$BACKUP_DIR/trusttunnel_client.toml" ]'
    else
        say "  skip classic backup (attach mode is confirmed or was set up by the installer)"
    fi
    chk "KeeneticOS settings saved"         'ndmc -c "system configuration save" >/dev/null 2>&1'
    if [ "$bad" -ne 0 ]; then say "Pre-flight failed — NOT rebooting"; return 1; fi
    say "All checks passed — rebooting the router in 5 s$([ -x "$GUARD_SCRIPT" ] && echo ' (the boot guard will verify the VPN)')"
    sleep 5
    ndmc -c "system reboot" >/dev/null 2>&1
}

cmd_guard() {
    [ "$TT_MODE" = "tun" ] && [ "$TUN_USE_EXISTING" = "yes" ] || exit 0
    log "boot guard: waiting for the VPN up to 4 minutes"
    if wait_vpn 240; then
        if stats_working; then
            log "boot guard: VPN works, dashboard statistics WORKING ($(ndm_stat_line))"
        else
            log "boot guard: VPN works, but KeeneticOS does not count the device yet ($(ndm_stat_line))"
        fi
        # one-time check of the switch: later outages at boot must not undo attach mode
        rm -f "$GUARD_SCRIPT"; log "boot guard: the switch is confirmed, guard removed"
        exit 0
    fi
    cmd_disable "after boot the VPN did not come up in attach mode within 4 minutes"
}

# ------------------------------------------------------------------ apply ---
# Safe replacement of the client config: backup -> new config -> restart ->
# check through the tunnel -> roll back by itself if the VPN does not come up.
# The check runs detached (start-stop-daemon), so an SSH drop or the VPN blip
# that the restart causes cannot stop the rollback halfway.
APPLY_DIR="$TT_DIR/backup-apply"
APPLY_STATE="/tmp/tt-stats.apply.state"
APPLY_LOCK="/tmp/tt-stats.apply.lock"     # a directory; its pid file names the owner
APPLY_NEW="$TT_DIR/.apply.new"
APPLY_KEEP=5
APPLY_OLDPID=""

apply_vpn_ok() {  # socks5 mode has no tunnel device: check through the proxy (the proxy resolves the name)
    if [ "$TT_MODE" = "tun" ]; then vpn_ok; return; fi
    code=$(curl --noproxy '' --socks5-hostname "${HC_SOCKS5_PROXY:-127.0.0.1:1080}" -s -o /dev/null -m 8 -w '%{http_code}' "$HC_TARGET_URL" 2>/dev/null) || return 1
    case "$code" in 2??|3??) return 0 ;; *) return 1 ;; esac
}

uptime_s() { cut -d. -f1 /proc/uptime; }   # monotonic: NTP clock steps do not move it

apply_new_pid() {  # true when a client process exists that was not there before the restart
    for _x in $(pidof trusttunnel_client 2>/dev/null); do
        case " $APPLY_OLDPID " in *" $_x "*) ;; *) return 0 ;; esac
    done
    return 1
}

apply_wait() {  # $1 = seconds; only a new client process counts
    _end=$(( $(uptime_s) + $1 ))
    while [ "$(uptime_s)" -lt "$_end" ]; do
        sleep 5
        apply_new_pid && apply_vpn_ok && [ "$(uptime_s)" -le $((_end + 10)) ] && return 0
    done
    return 1
}

apply_restart() {  # a hanging init script must not stall the check forever: TERM after 120 s, then KILL
    "$INIT_SCRIPT" restart >/dev/null 2>&1 </dev/null & _rp=$!
    _i=0; while kill -0 "$_rp" 2>/dev/null && [ "$_i" -lt "${APPLY_RESTART_MAX:-120}" ]; do sleep 1; _i=$((_i + 1)); done
    if kill -0 "$_rp" 2>/dev/null; then
        kill "$_rp" 2>/dev/null; sleep 3; kill -9 "$_rp" 2>/dev/null
        log "apply: the init script hung, stopped after ${_i}s"
    fi
    wait "$_rp" 2>/dev/null
}

pstart() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f20; }  # process start time (survives pid reuse)
lock_owner_alive() {  # the pid in the lock is running and is the same process that took the lock
    _lp=$(cat "$APPLY_LOCK/pid" 2>/dev/null)
    [ -n "$_lp" ] && kill -0 "$_lp" 2>/dev/null || return 1
    _ls=$(cat "$APPLY_LOCK/start" 2>/dev/null)
    [ -z "$_ls" ] || [ "$_ls" = "$(pstart "$_lp")" ]
}
lock_set_owner() {  # pid + start time of this process into the lock, each file replaced atomically
    pstart $$ > "$APPLY_LOCK/start.$$" && mv -f "$APPLY_LOCK/start.$$" "$APPLY_LOCK/start" && \
        echo $$ > "$APPLY_LOCK/pid.$$" && mv -f "$APPLY_LOCK/pid.$$" "$APPLY_LOCK/pid"
}

APPLY_OPID=""
apply_state() {  # shared state (apply-status) + this operation's own result file, both replaced atomically
    echo "$APPLY_OPID $*" > "$APPLY_STATE.tmp.$$" && mv -f "$APPLY_STATE.tmp.$$" "$APPLY_STATE"
    [ -n "$APPLY_OPID" ] && echo "$*" > "$APPLY_STATE.$APPLY_OPID.tmp" && mv -f "$APPLY_STATE.$APPLY_OPID.tmp" "$APPLY_STATE.$APPLY_OPID"
    log "apply: $*"
}
apply_state_text() {  # drops the operation id (pid.uptime); a state file from an older version has none
    sed -e 's/^[0-9][0-9]*\.[0-9][0-9]* //' "$APPLY_STATE" 2>/dev/null
}

apply_lock() {  # a lock whose owner is gone (killed, crashed) is stale and taken over
    if mkdir "$APPLY_LOCK" 2>/dev/null; then lock_set_owner && return 0; rm -rf "$APPLY_LOCK"; return 1; fi
    # only one process at a time may judge and remove a stale lock
    if ! mkdir "$APPLY_LOCK.takeover" 2>/dev/null; then
        # a guard older than a minute was left by a killed taker
        [ -n "$(find "$APPLY_LOCK.takeover" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$APPLY_LOCK.takeover" 2>/dev/null
        return 1
    fi
    _r=1; _o=$(cat "$APPLY_LOCK/pid" 2>/dev/null)
    if [ -z "$_o" ]; then   # owner may be between mkdir and writing its pid: busy unless older than a minute
        [ -n "$(find "$APPLY_LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ] && _o=stale
    elif lock_owner_alive; then
        _o=""
    elif [ -n "$(find "$APPLY_LOCK" -maxdepth 1 -name 'claimed.*' -mmin -1 2>/dev/null)" ]; then
        _o=""               # just handed to the background job, which is writing its pid
    fi
    if [ -n "$_o" ]; then
        rm -rf "$APPLY_LOCK"
        if mkdir "$APPLY_LOCK" 2>/dev/null; then
            lock_set_owner && _r=0 || rm -rf "$APPLY_LOCK"
        fi
    fi
    rmdir "$APPLY_LOCK.takeover" 2>/dev/null
    return $_r
}
apply_unlock() {  # only the owner removes the lock
    [ "$(cat "$APPLY_LOCK/pid" 2>/dev/null)" = "$$" ] && rm -rf "$APPLY_LOCK"
}

apply_put() {  # $1 = source -> live config, all or nothing (temp file + rename in the same directory)
    cp "$1" "$CONFIG_FILE.apply.tmp" 2>/dev/null && chmod 600 "$CONFIG_FILE.apply.tmp" && \
        mv -f "$CONFIG_FILE.apply.tmp" "$CONFIG_FILE" && return 0
    rm -f "$CONFIG_FILE.apply.tmp"; return 1
}

is_endpoint_header() { grep -q '^[[:space:]]*\[endpoint\][[:space:]]*\(#.*\)\{0,1\}$' "$1"; }

# tt://... link -> a full config: [endpoint] from the link (setup_wizard),
# everything else (tunnel, kill switch, routes, bound_if) and the router's has_ipv6 from the current config.
apply_link_to_config() {  # $1 = link, $2 = result file
    _w=$(mktemp -d /opt/tmp/tt_link.XXXXXX 2>/dev/null || mktemp -d) || return 1
    chmod 700 "$_w"
    if ! "$TT_DIR/setup_wizard" -m non-interactive -d "$1" --settings "$_w/raw.toml" >/dev/null 2>&1 || ! is_endpoint_header "$_w/raw.toml"; then
        rm -rf "$_w"; return 1
    fi
    # the merge works line by line: refuse TOML it cannot read safely instead of guessing
    if grep -q -e '"""' -e "'''" "$CONFIG_FILE" "$_w/raw.toml" || \
       cat "$CONFIG_FILE" "$_w/raw.toml" | grep '^[[:space:]]*\[' | \
           grep -v '^[[:space:]]*\[[[:space:]]*\(#.*\)\{0,1\}$' | \
           grep -qv '^[[:space:]]*\[[A-Za-z0-9_.-]\{1,\}\][[:space:]]*\(#.*\)\{0,1\}$'; then
        echo "The config uses multi-line strings or table names this merge cannot read ([[...]], quoted or spaced names): replace the [endpoint] part by hand." >&2
        rm -rf "$_w"; return 1
    fi
    # has_ipv6 describes the home network, not the server
    _v6=$(awk '/^[[:space:]]*\[[A-Za-z0-9_.-]+\][[:space:]]*(#.*)?$/ {f = ($0 ~ /^[[:space:]]*\[endpoint\]/)} f && /^[[:space:]]*has_ipv6[[:space:]]*=/ {print; exit}' "$CONFIG_FILE")
    awk -v v6="$_v6" '
        function issec(l) { return l ~ /^[[:space:]]*\[[A-Za-z0-9_.-]+\][[:space:]]*(#.*)?$/ }
        function isep(l) { return l ~ /^[[:space:]]*\[endpoint\][[:space:]]*(#.*)?$/ }
        FNR == NR {
            if (issec($0)) f = isep($0)
            else if (f) {
                if ($0 ~ /^[[:space:]]*has_ipv6[[:space:]]*=/) { seen6 = 1; if (v6 != "") $0 = v6 }
                ep = ep $0 "\n"
            }
            next
        }
        isep($0) { print "[endpoint]"; printf "%s", ep; if (v6 != "" && !seen6) print v6; skip = 1; done = 1; next }
        issec($0) { skip = 0 }
        !skip { print }
        END { exit !done }' "$_w/raw.toml" "$CONFIG_FILE" > "$2"
    _rc=$?
    rm -rf "$_w"
    [ "$_rc" -eq 0 ] && grep -q '^[[:space:]]*\[listener\(\.[A-Za-z0-9_-]\{1,\}\)*\][[:space:]]*\(#.*\)\{0,1\}$' "$2"
}

APPLY_PENDING="$TT_DIR/backup-apply/.pending"   # survives a reboot: backup path of an unfinished apply

apply_fg_exit() {  # foreground exit before the job took over: undo the request and free the lock
    [ -n "$lf" ] && rm -f "$lf"
    [ -n "$KB_TMP" ] && rm -rf "$KB_TMP"
    if [ -n "$APPLY_HANDOFF" ]; then
        # cancel the handoff; if the job already claimed it, the lock is the job's now
        # only a successful cancel proves the request is still ours; otherwise touch nothing
        mv "$APPLY_HANDOFF" "$APPLY_HANDOFF.cancelled" 2>/dev/null || return 0
        rm -f "$APPLY_STAGED"
    elif [ "$(cat "$APPLY_LOCK/pid" 2>/dev/null)" = "$$" ]; then
        rm -f "$APPLY_STAGED"   # nothing handed over yet: the staged file is ours alone
    fi
    apply_unlock
}

cmd_apply() {  # $1 = new config file or tt://... link, $2 = seconds to wait (default 60)
    new="$1"; secs=$(numor "$2" 60); lf=""
    umask 077   # temporary copies hold the password: private from the first byte
    [ "$secs" -lt 20 ] && secs=20
    [ -n "$new" ] || die "usage: tt-stats apply <new client config | tt://link> [seconds]"
    apply_lock || die "another apply is running: tt-stats apply-status"
    APPLY_HANDOFF=""; APPLY_STAGED="$APPLY_NEW"; KB_TMP=""
    trap 'apply_fg_exit' EXIT
    trap 'exit 1' INT TERM
    if [ -s "$APPLY_PENDING" ]; then
        _pb=$(cat "$APPLY_PENDING")
        if [ "$(readlink -f "$new" 2>/dev/null)" != "$(readlink -f "$_pb" 2>/dev/null)" ]; then
            die "an earlier apply did not finish. Restore its backup first: tt-stats apply $_pb  (or, if the VPN works with the current config: rm $APPLY_PENDING)"
        fi
        echo "Restoring the backup of the interrupted apply: $_pb"
    fi
    case "$new" in
        tt://*)
            [ -x "$TT_DIR/setup_wizard" ] || die "no $TT_DIR/setup_wizard to read the link"
            mkdir -p /opt/tmp; lf=$(mktemp /opt/tmp/tt_link_config.XXXXXX) || die "cannot create a temporary file"
            chmod 600 "$lf"
            apply_link_to_config "$new" "$lf" || die "the link was not accepted (setup_wizard could not read it); nothing changed"
            echo "Link read: the server part ([endpoint]) comes from the link, the rest stays as it is."
            src="$lf" ;;
        *)
            [ -s "$new" ] || die "usage: tt-stats apply <new client config | tt://link> [seconds]"
            [ "$(readlink -f "$new")" = "$(readlink -f "$CONFIG_FILE")" ] && die "give a copy, not the live config: cp $CONFIG_FILE /tmp/new.toml, edit it, then apply"
            src="$new" ;;
    esac
    is_endpoint_header "$src" || die "$src does not look like a client config: no [endpoint] section"
    cp "$src" "$APPLY_NEW" && chmod 600 "$APPLY_NEW" || die "cannot copy $src"
    apply_launch apply-run "$secs"
    echo "Applying: restart and check through the tunnel for up to ${secs}s; rolls back by itself."
    echo "Safe to close SSH now. Result: tt-stats apply-status, log: $LOG"
    apply_follow $((secs * 2 + 240))
}

# Start the background job $1 (args: $2 seconds, parent pid, operation id) and hand it the lock.
# The caller holds the lock and has staged its file in $APPLY_STAGED.
apply_launch() {
    APPLY_OPID="$$.$(uptime_s)"
    : > "$APPLY_LOCK/handoff.$APPLY_OPID" || die "cannot write the lock"
    APPLY_HANDOFF="$APPLY_LOCK/handoff.$APPLY_OPID"
    apply_state "started"
    # the job claims the lock by renaming the handoff file of this very operation: one rename wins
    start-stop-daemon -S -b -x "$SELF" -- "$1" "$2" "$$" "$APPLY_OPID" || die "cannot start the background check"
    _i=0
    while [ -e "$APPLY_HANDOFF" ] && [ "$_i" -lt 10 ]; do sleep 1; _i=$((_i + 1)); done
    if mv "$APPLY_HANDOFF" "$APPLY_HANDOFF.cancelled" 2>/dev/null; then
        # the job did not start: the request is taken back, a late job finds nothing to claim
        APPLY_HANDOFF=""; rm -f "$APPLY_STAGED"
        apply_state "FAILED: the background check did not start; nothing changed"
        die "the background check did not start; nothing changed"
    fi
    _i=0   # claimed: give the job a moment to write its pid before we let go
    while [ "$(cat "$APPLY_LOCK/pid" 2>/dev/null)" = "$$" ] && [ "$_i" -lt 5 ]; do sleep 1; _i=$((_i + 1)); done
    trap - EXIT INT TERM
    [ -n "$lf" ] && rm -f "$lf"
    [ -n "$KB_TMP" ] && rm -rf "$KB_TMP"
    return 0
}

apply_follow() {  # $1 = seconds: follow our own job by its operation id; 0 ok, 1 rolled back/failed, 2 still running
    _t=0; _last=""
    while [ "$_t" -lt "$1" ]; do
        sleep 3; _t=$((_t + 3))
        st=$(cat "$APPLY_STATE.$APPLY_OPID" 2>/dev/null)
        [ -n "$st" ] || continue
        [ "$st" != "$_last" ] && { echo "  $st"; _last="$st"; }
        case "$st" in
            ok*) rm -f "$APPLY_STATE.$APPLY_OPID"; return 0 ;;
            watching*) return 0 ;;   # works; the job keeps watching in the background
            rolled\ back*|FAILED*|stopped\ watching*) rm -f "$APPLY_STATE.$APPLY_OPID"; return 1 ;;
        esac
    done
    echo "Still running in the background: tt-stats apply-status"
    return 2
}

apply_claim() {  # $1 = operation id: rename its handoff file (fails if cancelled or not ours), then own the lock
    [ -n "$1" ] && mv "$APPLY_LOCK/handoff.$1" "$APPLY_LOCK/claimed.$1" 2>/dev/null || return 1
    lock_set_owner && return 0
    apply_state "FAILED: cannot take the lock over, nothing changed"; rm -f "$APPLY_STAGED"; rm -rf "$APPLY_LOCK"; return 1
}

cmd_apply_run() {  # background part; $1 = seconds, $2 = parent pid, $3 = operation id
    secs=$(numor "$1" 60); APPLY_OPID="$3"
    umask 077
    trap '' HUP INT
    APPLY_STAGED="$APPLY_NEW"
    apply_claim "$3" || return 1
    mkdir -p "$APPLY_DIR"
    bak="$APPLY_DIR/trusttunnel_client.toml.$(date +%Y%m%d_%H%M%S)"
    if ! cp -p "$CONFIG_FILE" "$bak" || [ ! -s "$bak" ]; then
        apply_state "FAILED: cannot back up the config, nothing changed"; rm -f "$APPLY_NEW"; apply_unlock; return 1
    fi
    _keep=$(cat "$APPLY_PENDING" 2>/dev/null)   # the backup of an interrupted apply is never rotated away
    # keep the newest APPLY_KEEP by name (the name holds the time; cp -p keeps the old mtime)
    ls -1 "$APPLY_DIR"/trusttunnel_client.toml.* 2>/dev/null | sort -r | tail -n +$((APPLY_KEEP + 1)) | \
        while read -r f; do [ "$f" != "$bak" ] && [ "$f" != "$_keep" ] && rm -f "$f"; done
    if ! { echo "$bak" > "$APPLY_PENDING.tmp" && mv -f "$APPLY_PENDING.tmp" "$APPLY_PENDING"; }; then
        rm -f "$APPLY_PENDING.tmp"
        apply_state "FAILED: cannot write the restore marker, nothing changed"; rm -f "$APPLY_NEW"; apply_unlock; return 1
    fi
    APPLY_OLDPID=$(pidof trusttunnel_client 2>/dev/null)
    if ! apply_put "$APPLY_NEW"; then
        rm -f "$APPLY_PENDING"
        apply_state "FAILED: cannot write the new config, the old one is untouched"; rm -f "$APPLY_NEW"; apply_unlock; return 1
    fi
    apply_state "new config in place (backup $bak), restarting the client"
    apply_restart
    if apply_wait "$secs"; then
        apply_state "ok: the VPN works with the new config (backup $bak)"
    else
        apply_state "the VPN did not come up in ${secs}s, rolling back"
        if ! apply_put "$bak"; then
            apply_state "FAILED: the rollback could not write the config; restore by hand: cp $bak $CONFIG_FILE"
            rm -f "$APPLY_NEW"; apply_unlock; return 1
        fi
        APPLY_OLDPID=$(pidof trusttunnel_client 2>/dev/null)
        apply_restart
        if apply_wait 90; then apply_state "rolled back: the old config is in place and the VPN works"
        else apply_state "rolled back: the old config is in place, but the VPN is still down (the watchdog keeps trying)"; fi
    fi
    rm -f "$APPLY_PENDING" "$APPLY_NEW"; apply_unlock
}

cmd_apply_status() {
    if [ -d "$APPLY_LOCK" ]; then
        if lock_owner_alive; then echo "running: $(apply_state_text)"
        else echo "stale (the job is gone, the next apply takes over): $(apply_state_text)"; fi
    elif [ -f "$APPLY_STATE" ]; then echo "last: $(apply_state_text)"
    else echo "no apply since the last reboot"; fi
    if [ -s "$APPLY_PENDING" ] && ! { [ -d "$APPLY_LOCK" ] && lock_owner_alive; }; then
        echo "INTERRUPTED: an apply did not finish. If the VPN does not work, restore: tt-stats apply $(cat "$APPLY_PENDING")"
    fi
}

# ------------------------------------------------ client build with auth key ---
# The official client for MIPS routers is built with OpenSSL and ignores client_random_auth_key.
# keybuild install swaps in this project's build (official sources + a small OpenSSL patch) with the
# same lock, background job and rollback as apply, then keeps watching the VPN for KB_WATCH seconds.
KB_ASSET="${KB_ASSET:-trusttunnel_client-authkey-mipsel}"
KB_OFFICIAL="$TT_DIR/trusttunnel_client.official"   # the client it replaced
KB_NEW="$TT_DIR/.keybuild.new"                       # staged binary
KB_PREV="$TT_DIR/.keybuild.prev"                     # what to go back to if the switch fails
KB_PENDING="$TT_DIR/backup-apply/.keybuild-pending"
KB_WATCH=$(numor "$KB_WATCH" 600)
KB_TMP=""

elf_bytes() {  # octal bytes, as BusyBox od knows only the classic options
    dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | od -b | awk 'NR == 1 {$1 = ""; printf "%s", $0}' | tr -d ' '
}
is_mipsel_bin() {  # ELF, 32-bit, little-endian, machine 8 (MIPS)
    [ "$(elf_bytes "$1" 0 6)" = "177105114106001001" ] && [ "$(elf_bytes "$1" 18 2)" = "010000" ]
}
has_key_support() {  # $1 = client binary: 0 supports the auth key, 1 ignores it, 2 cannot tell
    [ -f "$1" ] && [ -r "$1" ] && [ -s "$1" ] || return 2
    grep -q 'client_random_auth_key' "$1" 2>/dev/null   # older than the option: ignores it too
    case $? in 0) ;; 1) return 1 ;; *) return 2 ;; esac
    grep -q 'SSL_set_custom_client_random is unavailable' "$1" 2>/dev/null
    case $? in 0) return 1 ;; 1) return 0 ;; *) return 2 ;; esac
}
kb_eligible() {  # a mipsel client that ignores the key: the build helps here
    [ -x "$CLIENT_BIN" ] && is_mipsel_bin "$CLIENT_BIN" || return 1
    has_key_support "$CLIENT_BIN"; [ $? -eq 1 ]
}
bin_version() { "$1" --version 2>/dev/null | awk '{print $2; exit}'; }
kb_put() {  # $1 = binary -> live client, all or nothing
    cp -p "$1" "$CLIENT_BIN.tmp" 2>/dev/null && chmod 755 "$CLIENT_BIN.tmp" && \
        mv -f "$CLIENT_BIN.tmp" "$CLIENT_BIN" && return 0
    rm -f "$CLIENT_BIN.tmp"; return 1
}

cmd_keybuild_status() {
    has_key_support "$CLIENT_BIN"
    case $? in 0) k="supports the auth key" ;; 1) k="ignores the auth key" ;; *) k="cannot tell" ;; esac
    echo "Client:          $(bin_version "$CLIENT_BIN" || true) ($k)"
    [ -s "$KB_OFFICIAL" ] && echo "Replaced client: $KB_OFFICIAL ($(bin_version "$KB_OFFICIAL")) - back to it: tt-stats keybuild revert"
    kb_eligible && echo "This router can use the client build with auth key support: tt-stats keybuild install"
    [ -s "$KB_PENDING" ] && echo "INTERRUPTED: a client switch did not finish. If the VPN does not work: tt-stats keybuild revert"
    return 0
}

kb_begin() {  # common start of install/revert in the foreground
    umask 077
    [ -x "$CLIENT_BIN" ] || die "no client at $CLIENT_BIN"
    apply_lock || die "another apply is running: tt-stats apply-status"
    APPLY_HANDOFF=""; APPLY_STAGED="$KB_NEW"; KB_TMP=""; lf=""
    trap 'apply_fg_exit' EXIT
    trap 'exit 1' INT TERM
    [ -s "$APPLY_PENDING" ] && die "an earlier apply did not finish: tt-stats apply-status"
}

cmd_keybuild_install() {  # $1 = optional local file instead of the download
    kb_begin
    is_mipsel_bin "$CLIENT_BIN" || die "this build is for MIPS little-endian (mipsel) routers; this client is for another CPU. Nothing changed."
    has_key_support "$CLIENT_BIN"; [ $? -eq 0 ] && { echo "The client already supports the auth key - nothing to do."; return 0; }
    mkdir -p /opt/tmp; KB_TMP=$(mktemp -d /opt/tmp/tt_keybuild.XXXXXX) || die "cannot create a temporary folder"
    if [ -n "$1" ]; then
        cp "$1" "$KB_TMP/client" 2>/dev/null || die "cannot read $1"
        [ -s "$1.sha256" ] && cp "$1.sha256" "$KB_TMP/client.sha256"
    else
        echo "Downloading the client build with auth key support..."
        curl -fsSL -m 600 "$TTS_REPO_URL/$KB_ASSET" -o "$KB_TMP/client" && \
            curl -fsSL -m 60 "$TTS_REPO_URL/$KB_ASSET.sha256" -o "$KB_TMP/client.sha256" || \
            die "download failed ($TTS_REPO_URL/$KB_ASSET); nothing changed"
    fi
    if [ -s "$KB_TMP/client.sha256" ]; then
        _want=$(awk '{print $1; exit}' "$KB_TMP/client.sha256"); _got=$(sha256sum "$KB_TMP/client" 2>/dev/null | awk '{print $1}')
        [ -n "$_want" ] && [ "$_want" = "$_got" ] || die "checksum mismatch; nothing changed"
    elif [ -z "$1" ]; then
        die "no checksum next to the download; nothing changed"
    fi
    chmod 755 "$KB_TMP/client"
    is_mipsel_bin "$KB_TMP/client" || die "the file is not a mipsel client; nothing changed"
    bin_version "$KB_TMP/client" | grep -q '^[0-9]' || die "the new build does not start on this router; nothing changed"
    has_key_support "$KB_TMP/client"; [ $? -eq 0 ] || die "the file is not a build with auth key support; nothing changed"
    cp -p "$KB_TMP/client" "$KB_NEW" && chmod 755 "$KB_NEW" || die "cannot stage the new build (free space in $TT_DIR?)"
    echo "New build: $(bin_version "$KB_NEW"), the current client: $(bin_version "$CLIENT_BIN")"
    apply_launch keybuild-install-run 90
    echo "Switching the client: restart, check through the tunnel for up to 90s, then watch for $((KB_WATCH / 60)) minutes;"
    echo "the replaced client comes back by itself if the VPN fails. Safe to close SSH. Result: tt-stats apply-status"
    apply_follow 400
}

cmd_keybuild_revert() {
    kb_begin
    [ -s "$KB_OFFICIAL" ] || die "no replaced client to go back to ($KB_OFFICIAL)"
    cmp -s "$KB_OFFICIAL" "$CLIENT_BIN" && { echo "The replaced client is already in place."; rm -f "$KB_OFFICIAL"; return 0; }
    cp -p "$KB_OFFICIAL" "$KB_NEW" && chmod 755 "$KB_NEW" || die "cannot stage the client (free space in $TT_DIR?)"
    apply_launch keybuild-revert-run 90
    echo "Putting the replaced client back: restart and check through the tunnel for up to 90s. Result: tt-stats apply-status"
    apply_follow 400
}

kb_switch() {  # $1 = install|revert; the job owns the lock, $KB_NEW is staged
    mkdir -p "$APPLY_DIR"
    if [ "$1" = install ] && ! cmp -s "$KB_OFFICIAL" "$CLIENT_BIN"; then
        # keep the replaced client only if it is one without key support (never save a custom build over it)
        if [ ! -s "$KB_OFFICIAL" ] || { has_key_support "$CLIENT_BIN"; [ $? -eq 1 ]; }; then
            cp -p "$CLIENT_BIN" "$KB_OFFICIAL.tmp" && mv -f "$KB_OFFICIAL.tmp" "$KB_OFFICIAL" || {
                rm -f "$KB_OFFICIAL.tmp"; apply_state "FAILED: cannot save the current client, nothing changed"; return 1; }
        fi
    fi
    cp -p "$CLIENT_BIN" "$KB_PREV.tmp" && mv -f "$KB_PREV.tmp" "$KB_PREV" || {
        rm -f "$KB_PREV.tmp"; apply_state "FAILED: cannot save the current client, nothing changed"; return 1; }
    if ! { echo "$1" > "$KB_PENDING.tmp" && mv -f "$KB_PENDING.tmp" "$KB_PENDING"; }; then
        rm -f "$KB_PENDING.tmp"; apply_state "FAILED: cannot write the restore marker, nothing changed"; return 1
    fi
    APPLY_OLDPID=$(pidof trusttunnel_client 2>/dev/null)
    kb_put "$KB_NEW" || { apply_state "FAILED: cannot put the new client in place, the old one is untouched"; return 1; }
    apply_state "client $(bin_version "$CLIENT_BIN") in place, restarting"
    apply_restart
    apply_wait 90 || { kb_back "the VPN did not come up in 90s"; return 1; }
    [ "$1" = revert ] && { apply_state "ok: the replaced client $(bin_version "$CLIENT_BIN") is back and the VPN works"; rm -f "$KB_OFFICIAL"; return 0; }
    apply_state "watching: the VPN works with $(bin_version "$CLIENT_BIN"); checking it for $((KB_WATCH / 60)) more minutes"
    _f=0; _t=0
    while [ "$_t" -lt "$KB_WATCH" ]; do
        sleep 30; _t=$((_t + 30))
        # someone else (the installer, by hand) changed the client: not ours to judge or roll back
        if ! cmp -s "$KB_NEW" "$CLIENT_BIN"; then
            apply_state "stopped watching: the client was replaced meanwhile (now $(bin_version "$CLIENT_BIN")); nothing rolled back"
            return 1
        fi
        if apply_vpn_ok; then _f=0; else
            _f=$((_f + 1)); log "keybuild: check failed ($_f in a row)"
            [ "$_f" -ge 4 ] && { kb_back "the VPN failed 4 checks in a row after the switch"; return 1; }
        fi
    done
    cmp -s "$KB_NEW" "$CLIENT_BIN" || {
        apply_state "stopped watching: the client was replaced meanwhile (now $(bin_version "$CLIENT_BIN")); nothing rolled back"; return 1; }
    apply_state "ok: the client $(bin_version "$CLIENT_BIN") with auth key support stays (replaced client kept: $KB_OFFICIAL)"
}

kb_back() {  # $1 = reason: put the previous client back
    if [ -s "$KB_NEW" ] && ! cmp -s "$KB_NEW" "$CLIENT_BIN"; then
        apply_state "$1, but the client was replaced meanwhile (now $(bin_version "$CLIENT_BIN")); nothing rolled back"; return 1
    fi
    apply_state "$1, rolling back"
    if ! kb_put "$KB_PREV"; then
        apply_state "FAILED: the rollback could not write the client; restore by hand: cp $KB_PREV $CLIENT_BIN"; return 1
    fi
    APPLY_OLDPID=$(pidof trusttunnel_client 2>/dev/null)
    apply_restart
    if apply_wait 90; then apply_state "rolled back: the previous client $(bin_version "$CLIENT_BIN") is in place and the VPN works"
    else apply_state "rolled back: the previous client is in place, but the VPN is still down (the watchdog keeps trying)"; fi
}

cmd_keybuild_run() {  # background part; $1 = install|revert, $2 = seconds, $3 = parent pid, $4 = operation id
    APPLY_OPID="$4"; APPLY_STAGED="$KB_NEW"
    umask 077
    trap '' HUP INT
    apply_claim "$4" || return 1
    kb_switch "$1"
    # after a rolled-back install the "replaced" client is the live one: no copy to offer
    [ "$1" = install ] && cmp -s "$KB_OFFICIAL" "$CLIENT_BIN" && rm -f "$KB_OFFICIAL"
    rm -f "$KB_NEW" "$KB_PREV" "$KB_PENDING"; apply_unlock
    sleep 5; rm -f "$APPLY_STATE.$APPLY_OPID"   # the foreground has read it by now or left after "watching"
}

# --------------------------------------------------------------- selftest ---
# One read-only check of the whole setup. Changes nothing, never stops the VPN.
# Exit code = number of failed checks.
ST_IP_URL="${ST_IP_URL:-https://api.ipify.org}"
ST_DOH_URL="${ST_DOH_URL:-https://1.1.1.1/dns-query?name=example.com&type=A}"
st_fail=0
st_line() {  # $1 = ok|warn|fail, $2 = check, $3 = details
    case "$1" in ok) m="[ OK ]" ;; warn) m="[WARN]" ;; *) m="[FAIL]"; st_fail=$((st_fail + 1)) ;; esac
    printf '%s %-16s %s\n' "$m" "$2" "$3"
}
st_curl() {  # through the tunnel: device in TUN mode, proxy in SOCKS5 mode
    if [ "$TT_MODE" = "tun" ]; then curl --interface "$OPKG_IFACE" -s -m 10 "$@" 2>/dev/null
    else curl --noproxy '' --socks5-hostname "${HC_SOCKS5_PROXY:-127.0.0.1:1080}" -s -m 10 "$@" 2>/dev/null; fi
}
is_ip() {  # exactly one IPv4 (octets 0-255) or IPv6 address (RFC 4291 text form), nothing else
    printf '%s\n' "$1" | awk '
        function v4(x,   n, o, i) {
            if (x !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return 0
            n = split(x, o, "."); for (i = 1; i <= n; i++) if (length(o[i]) > 3 || o[i] + 0 > 255) return 0
            return 1
        }
        function v6(x,   parts, n, i, g, groups, dbl, h, t) {
            if (x !~ /:/ || x ~ /:::/) return 0
            dbl = gsub(/::/, "::", x); if (dbl > 1) return 0
            if (x ~ /^:[^:]/ || x ~ /[^:]:$/) return 0
            groups = 0; n = split(x, parts, ":")
            for (i = 1; i <= n; i++) {
                g = parts[i]; if (g == "") continue
                if (i == n && g ~ /\./) { if (!v4(g)) return 0; groups += 2; continue }
                if (g !~ /^[0-9a-fA-F]+$/ || length(g) > 4) return 0
                groups++
            }
            return dbl ? groups < 8 : groups == 8
        }
        NR > 1 { bad = 1 }
        NR == 1 { ok = v4($0) || v6($0) }
        END { exit !(ok && !bad) }'
}

# Auth key state: the key is in the config, but a build without
# SSL_set_custom_client_random silently connects without it (official Keenetic MIPS builds).
# The binary itself tells: only such builds carry the "is unavailable in this build" warning text.
auth_key_state() {  # prints: none | works | ignored | unknown | noconfig
    grep -q "^[[:space:]]*client_random_auth_key[[:space:]]*=[[:space:]]*[\"'][0-9a-fA-F]" "$CONFIG_FILE" 2>/dev/null
    case $? in 0) ;; 1) echo none; return ;; *) echo noconfig; return ;; esac
    has_key_support "$CLIENT_BIN"
    case $? in 0) echo works ;; 1) echo ignored ;; *) echo unknown ;; esac
}

cmd_selftest() {
    st_fail=0
    echo "tt-stats $TTS_VERSION selftest ($(ts)), mode $TT_MODE"
    ver=$(client_version)
    if [ -z "$ver" ]; then st_line fail "client" "not installed ($CLIENT_BIN)"
    elif pidof trusttunnel_client >/dev/null 2>&1; then st_line ok "client" "$ver, running"
    else st_line fail "client" "$ver, NOT running: /opt/etc/init.d/S99trusttunnel start"; fi
    if [ "$TT_MODE" = "tun" ]; then
        if ip link show "$OPKG_IFACE" >/dev/null 2>&1; then st_line ok "device" "$OPKG_IFACE present"
        else st_line fail "device" "$OPKG_IFACE absent"; fi
    fi
    if apply_vpn_ok; then st_line ok "vpn" "$HC_TARGET_URL answers through the tunnel"
    else st_line fail "vpn" "no answer through the tunnel"; fi
    vip=$(st_curl "$ST_IP_URL") || vip=""; dip=$(curl --noproxy '*' -s -m 10 "$ST_IP_URL" 2>/dev/null) || dip=""
    is_ip "$dip" || dip=""
    if ! is_ip "$vip"; then st_line fail "exit ip" "unknown (no valid answer through the tunnel)"
    elif [ "$vip" = "$dip" ]; then st_line warn "exit ip" "$vip, same as the router's own request: cannot tell (the router itself may go through the VPN)"
    else st_line ok "exit ip" "$vip through the tunnel (router itself: ${dip:-unknown})"; fi
    _doh=$(st_curl -f -H 'accept: application/dns-json' "$ST_DOH_URL")
    if printf '%s' "$_doh" | grep -Eq '"Status" *: *0[,}]' && printf '%s' "$_doh" | grep -Eq '"Answer" *: *\[ *\{[^]]*"type" *: *1[,}]'; then st_line ok "dns" "DNS over HTTPS works through the tunnel"
    else st_line warn "dns" "DNS over HTTPS through the tunnel did not answer"; fi
    # Several addresses in [endpoint] addresses = [...]: the client itself pings them and moves
    # to a live one when the current one is blocked (about 70 s for a silent block, 15 s for a reset)
    n=$(awk '/^[[:space:]]*\[[A-Za-z0-9_.-]+\][[:space:]]*(#.*)?$/ {f = ($0 ~ /^[[:space:]]*\[endpoint\]/); next}
             f && !a && /^[[:space:]]*addresses[[:space:]]*=/ {a = 1; sub(/^[^=]*=/, "")}
             a { l = $0; sub(/#.*/, "", l); c += gsub(/"[^"]*"|\047[^\047]*\047/, "", l); if (l ~ /\]/) { print c; exit } }' "$CONFIG_FILE")
    cur=$(awk '/Starting event loop/ {a = ""} /Using endpoint:/ {sub(/.*address=/, ""); sub(/,.*/, ""); a = $0} END {print a}' "$CLIENT_LOG" 2>/dev/null)
    case "$n" in
        ''|0) st_line warn "servers" "could not read addresses = [...] in [endpoint] (now using ${cur:-unknown})" ;;
        1)    st_line warn "servers" "one address (${cur:-unknown}): no spare if it gets blocked; add a second one to addresses = [...]" ;;
        *)    st_line ok "servers" "$n addresses, now using ${cur:-unknown}; the client moves to a live one by itself" ;;
    esac
    if grep -q '^[[:space:]]*killswitch_enabled[[:space:]]*=[[:space:]]*true' "$CONFIG_FILE" 2>/dev/null; then st_line ok "kill switch" "on in the client config"
    else st_line fail "kill switch" "OFF: if the server is down, traffic goes direct"; fi
    case "$(auth_key_state)" in
        none)    st_line ok "auth key" "not used" ;;
        works)   st_line ok "auth key" "set, this client build supports it" ;;
        ignored) st_line fail "auth key" "set, but this client build IGNORES it (no SSL_set_custom_client_random): a server with a deny rule will drop this router" ;;
        noconfig) st_line warn "auth key" "the client config cannot be read: cannot tell whether a key is set" ;;
        *)       st_line warn "auth key" "set, but the client binary cannot be read: cannot tell whether it supports the key" ;;
    esac
    hc=$(cat /opt/var/run/trusttunnel_hc_state 2>/dev/null)
    case "$hc" in ok*) st_line ok "health check" "$hc" ;; "") st_line warn "health check" "no result yet" ;; *) st_line warn "health check" "$hc" ;; esac
    st_line ok "memory" "free $(mem_avail) kB"
    [ "$st_fail" -eq 0 ] && echo "Result: all checks passed" || echo "Result: $st_fail check(s) failed"
    return "$st_fail"
}

case "$1" in
    status|"") cmd_status ;;
    enable)    cmd_enable "$2" ;;
    disable)   cmd_disable "${2:-manual}" ;;
    reboot)    cmd_reboot ;;
    guard)     cmd_guard ;;
    memguard)  cmd_memguard "$2" "$3" ;;
    memguard-run)   cmd_memguard_run ;;
    memguard-nightly) cmd_memguard_nightly ;;
    memguard-start) mg_start ;;
    dnslimit-apply) dnslim_apply ;;
    memguard-stop)  mg_stop ;;
    version)   echo "$TTS_VERSION" ;;
    update-check) cmd_update_check "$2" ;;
    apply)     cmd_apply "$2" "$3"; exit $? ;;
    apply-run) cmd_apply_run "$2" "$3" "$4" ;;
    apply-status) cmd_apply_status ;;
    selftest)  cmd_selftest; exit $? ;;
    keybuild)
        case "$2" in
            ""|status) cmd_keybuild_status ;;
            install)   cmd_keybuild_install "$3"; exit $? ;;
            revert)    cmd_keybuild_revert; exit $? ;;
            eligible)  kb_eligible; exit $? ;;
            *) echo "Usage: tt-stats keybuild [status|install [FILE]|revert]"; exit 1 ;;
        esac ;;
    keybuild-install-run) cmd_keybuild_run install "$2" "$3" "$4" ;;
    keybuild-revert-run)  cmd_keybuild_run revert "$2" "$3" "$4" ;;
    *) echo "Usage: tt-stats {status|enable [--reboot]|disable|reboot|memguard [on [KB]|off]|apply <config|tt://link> [seconds]|apply-status|selftest|keybuild [status|install|revert]|version}"; exit 1 ;;
esac
